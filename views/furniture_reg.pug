doctype html
head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Furniture Stock Registration
    link(rel='stylesheet' href='css/sales.css')
    link(href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet")
.sidebar
    h2 MAYONDO INVENTORY MANAGEMENT SYSTEM
    a(href='/viewboard') 
      span.material-icons-outlined.me-2 dashboard
      | Dashboard
    a(href='/')
      span.material-icons-outlined.me-2 home
      | Home
    a(href='/salesReport')
      span.material-icons-outlined.me-2 bar_chart
      | Sales Report
    a(href='/furnitureRegistered')
      span.material-icons-outlined.me-2 view_list
      | View Furniture Stock
    a(href='/woodRegistered')
      span.material-icons-outlined.me-2 inventory_2
      | View Wood Stock
    a(href='/recordfurnitureSale')
      span.material-icons-outlined.me-2 point_of_sale
      | Add Furniture Sale
    a(href='/recordwoodSale')
      span.material-icons-outlined.me-2 shopping_cart
      | Add Wood Sale
    a(href='/logout')
      button.logout-btn Logout 

form#furnitureForm(action='/furnitureRegistration' method='post' enctype='multipart/form-data')
      h2 Furniture Stock Registration

      #progress-bar
          span#step-1-indicator.active 1. Identification
          span#step-2-indicator 2. Material & Date
          span#step-3-indicator 3. Stock & Price

      fieldset.form-step#step-1
          label(for='itemName') Furniture Name
          input#itemName(type='text' name='furniturename' placeholder='e.g., Console Table' required)
          span.error-msg#itemNameError.error

          label(for='image') Furniture Image
          input#image(type='file' name='furnitureimage' placeholder='upload image' accept='image/*' required)
          span.error-msg#imageError.error
                
          label(for='category') Furniture Category
          select#category(name='category' required)
              option(value='') -- Select Category --
              option(value='Office') Office Furniture
              option(value='Home') Home Furniture
              option(value='Outdoor') Outdoor Furniture
              option(value='Custom') Custom Orders
          span.error-msg#categoryError.error

          
          button.next-btn(type='button') Next: Material & Date

      
      fieldset.form-step#step-2
          label(for='material') Wood Type / Material
          select#material(name='material' required)
              option(value='') -- Select Material --
              option(value='Mahogany') Mahogany
              option(value='Muvule') Muvule
              option(value='Teak') Teak
              option(value='Pine') Pine
              option(value='Metal') Metal Frame
              option(value='Glass') Glass / Mixed
          span.error-msg#materialError.error

          label(for='date') Date Produced
          input#productionDate(type='date' name='date' required)
          span.error-msg#dateError.error

          button.prev-btn(type='button') Previous
          button.next-btn(type='button') Next: Stock & Price

      fieldset.form-step#step-3
          label(for='quantity') Quantity
          input#quantity(type='number' name='quantity' min='1' required)
          span.error-msg#quantityError.error

          label(for='price') Unit Price (UGX)
          input#price(type='number' name='unitprice' min='1' required)
          span.error-msg#priceError.error

          button.prev-btn(type='button') Previous
          button(type='submit') Register Furniture Stock!

script(src="/js/validateFurnitureReg.js")
